USER=change-me
PASS=change-me
# IPs con permiso de conectarse al RPC (comodines por octeto; no reemplaza el login).
# 127.0.0.1 = loopback del contenedor (healthcheck); 172.30.20.1 = gateway de
# infra_net, es como llega cloudflared desde el host. Luego los rangos de tu LAN.
WHITELIST=127.0.0.1,172.30.20.1,192.168.1.*
# Nombres de host aceptados en la cabecera Host (LAN y túnel/proxy)
HOST_WHITELIST=raspberrypi.local,transmission.example.com
# Carpeta de descargas en el host (complete/, incomplete/ y watch/ cuelgan de aquí)
DOWNLOADS_DIR=/mnt/usb-downloads/Descargas
